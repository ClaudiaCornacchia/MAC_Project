# --------------------
# 1. SISTEMA OPERATIVO & IDE
# --------------------
# Mac
.DS_Store

# Windows
Thumbs.db

# VS Code & Editor config
.vscode/
.idea/
*.iml
*.swp

# --------------------
# 2. BACKEND (Node.js & Docker)
# --------------------
# Dipendenze (mai committare, pesano centinaia di MB)
node_modules/

# Build di produzione (se userai TypeScript o build step)
dist/
build/

# Log di errore
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# SICUREZZA: Variabili d'ambiente e chiavi (CRUCIALE)
.env
.env.local
.env.*.local

# Docker (se vuoi ignorare i log o file temporanei docker)
docker-compose.override.yml

# --------------------
# 3. MOBILE APP (Android/Kotlin)
# --------------------
# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc) - Mai committare
local.properties

# Build outputs (APK, AAB)
*.apk
*.aab

# Android Studio generated files
captures/
.externalNativeBuild/
.cxx/

# Keystore files (Chiavi per firmare l'app - PERICOLO SICUREZZA)
*.jks
*.keystore
*.pem